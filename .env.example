# Copia este archivo a .env.local y llena los valores.
# .env.local NO se sube al repositorio.

# --- Supabase ---
# Con el stack local (npx supabase start) los valores salen impresos en
# la consola al arrancar. Con un proyecto en la nube salen en
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Llave de servicio: se salta RLS por completo.
# Solo en el servidor. Jamás en un componente cliente, jamás en el repo.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
